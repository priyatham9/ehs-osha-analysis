# Data: raw agency files are large and re-downloadable. Never commit them.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Generated analysis outputs. Regenerate with scripts/run_analysis.py.
outputs/**/*.csv
outputs/**/*.svg
outputs/**/*.md
outputs/**/*.json
!outputs/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environments
.env
.venv
env/
venv/
ENV/

# Testing / tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
