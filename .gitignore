# Data: raw agency files are large and re-downloadable. Never commit them.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Generated analysis outputs are committed on purpose so a clone can read the tables and rebuild the site without a 107 s pipeline run. Regenerate with make analysis.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environments
.env
.venv
env/
venv/
ENV/

